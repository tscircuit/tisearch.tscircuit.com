{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "vitest/globals",
      "@cloudflare/vitest-pool-workers"
    ]
  },
  "include": ["src", "scripts", "test", "vitest.config.ts"]
}
